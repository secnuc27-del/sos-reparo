{
  "rules": {
    "chats": {
      "$token": {
        "mensagens": {
          ".read": true,
          "$mensagemId": {
            ".write": "!data.exists() && newData.exists()"
          }
        }
      }
    },
    "chatOS": {
      "$token": {
        ".read": true,
        ".write": true
      }
    },
    "publicOS": {
      ".read": true,
      ".write": true
    },
    "clientes": {
      ".read": true,
      ".write": true
    },
    "equipamentosEdicoes": {
      ".read": true,
      ".write": true
    }
  }
}
